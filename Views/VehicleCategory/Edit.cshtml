@model VehicleManagement.ViewModels.VehicleCategoryEditViewModel

@{
    ViewData["Title"] = "Edit Vehicle Category";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Edit Vehicle Category</h2>
            <p class="text-muted mb-0">Update the category name and weight range.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Categories
        </a>
    </div>

    <!-- Validation Summary (only rendered when there are model-level errors) -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <!-- Edit Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">Category Details</h5>
        </div>

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <!-- Category Name -->
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Weight Range -->
                <div class="row">

                    <div class="col-md-6 mb-4">
                        <label asp-for="MinWeight" class="form-label fw-semibold">Minimum Weight (kg)</label>
                        <input asp-for="MinWeight"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="Enter minimum weight" />
                        <span asp-validation-for="MinWeight" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="MaxWeight" class="form-label fw-semibold">Maximum Weight (kg)</label>
                        <input asp-for="MaxWeight"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="Enter maximum weight" />
                        <span asp-validation-for="MaxWeight" class="text-danger"></span>
                    </div>

                </div>

                <!-- Information -->
                <div class="alert alert-info d-flex">
                    <i class="bi bi-info-circle me-2"></i>
                    <div>
                        When the weight range is changed, every existing vehicle is
                        re-categorised automatically according to its weight.
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>
                        Save Changes
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // Convenience only: the server remains the source of truth for range validation.
        document.addEventListener("DOMContentLoaded", () => {
            const minInput = document.getElementById("MinWeight");
            const maxInput = document.getElementById("MaxWeight");

            function validateRange() {
                const min = parseFloat(minInput.value);
                const max = parseFloat(maxInput.value);
                const isInvalid = !isNaN(min) && !isNaN(max) && min >= max;

                maxInput.setCustomValidity(
                    isInvalid ? "Maximum weight must be greater than minimum weight." : ""
                );
            }

            minInput.addEventListener("input", validateRange);
            maxInput.addEventListener("input", validateRange);
        });
    </script>

}
