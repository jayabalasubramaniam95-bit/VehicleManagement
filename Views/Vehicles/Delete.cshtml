@model VehicleManagement.ViewModels.VehicleDetailsViewModel

@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="page-header">
    <div>
        <h1>Delete Vehicle</h1>
        <p class="page-subtitle">Please review the vehicle details before deleting.</p>
    </div>

    <a asp-action="Index" class="btn btn-light">Back to Vehicles</a>
</div>

<div class="form-card delete-card">

    <div class="delete-warning">
        <h3>Are you sure you want to delete this vehicle?</h3>
        <p>This action cannot be undone.</p>
    </div>

    <div class="details-grid">

        <div class="detail-item">
            <span class="detail-label">@Html.DisplayNameFor(m => m.OwnerName)</span>
            <span class="detail-value">@Html.DisplayFor(m => m.OwnerName)</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">@Html.DisplayNameFor(m => m.ManufacturerName)</span>
            <span class="detail-value">@Html.DisplayFor(m => m.ManufacturerName)</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">@Html.DisplayNameFor(m => m.YearOfManufacture)</span>
            <span class="detail-value">@Html.DisplayFor(m => m.YearOfManufacture)</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">@Html.DisplayNameFor(m => m.WeightKg)</span>
            <span class="detail-value">@Model.WeightKg.ToString("0.00") kg</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">@Html.DisplayNameFor(m => m.CategoryName)</span>
            <span class="detail-value">
                <span class="category-badge">@Html.DisplayFor(m => m.CategoryName)</span>
            </span>
        </div>

    </div>

    <div class="form-actions">
        <form asp-action="Delete" method="post" class="delete-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete Vehicle</button>
        </form>

        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>

</div>