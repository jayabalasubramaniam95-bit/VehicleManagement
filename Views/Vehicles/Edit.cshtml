@model VehicleManagement.ViewModels.VehicleFormViewModel

@{
    ViewData["Title"] = "Edit Vehicle";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1>Edit Vehicle</h1>
        <p class="page-subtitle">Update vehicle information</p>
    </div>

    <a asp-action="Index" class="btn btn-light">Back to Vehicles</a>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<!-- Edit Form -->
<div class="form-card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="OwnerName" class="form-label"></label>
            <input asp-for="OwnerName" class="form-control" placeholder="Enter owner name" />
            <span asp-validation-for="OwnerName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ManufacturerId" class="form-label"></label>
            <select asp-for="ManufacturerId" asp-items="Model.Manufacturers" class="form-control">
                <option value="">-- Select Manufacturer --</option>
            </select>
            <span asp-validation-for="ManufacturerId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="YearOfManufacture" class="form-label"></label>
            <input asp-for="YearOfManufacture" type="number" class="form-control" />
            <span asp-validation-for="YearOfManufacture" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="WeightKg" class="form-label"></label>
            <input asp-for="WeightKg" type="number" step="0.01" class="form-control" placeholder="Enter weight in kg" />
            <span asp-validation-for="WeightKg" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </div>

    </form>
</div>

@section Scripts
{
}