@model VehicleManagement.ViewModels.ManufacturerListViewModel

@{
    ViewData["Title"] = "Manufacturers";
}

<div class="page-container">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1>Manufacturers</h1>
            <p class="page-subtitle">Manage registered vehicle manufacturers</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">+ Add Manufacturer</a>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Search -->
    <div class="toolbar">
        <div class="search-group">
            <label for="manufacturerSearch">Search manufacturers</label>
            <input type="text"
                   id="manufacturerSearch"
                   class="form-control"
                   value="@Model.Search"
                   placeholder="Search manufacturer..."
                   autocomplete="off" />
        </div>

        <div class="search-result-info">
            <span id="searchResultCount"></span>
        </div>
    </div>

    <!-- Manufacturer Table -->
    @if (!Model.Manufacturers.Any())
    {
        <div class="empty-state">
            <h3>No manufacturers found</h3>

            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <p>No manufacturers match "<strong>@Model.Search</strong>".</p>
            }
            else
            {
                <p>No manufacturers have been registered yet.</p>
            }

            <a asp-action="Create" class="btn btn-primary">Add Manufacturer</a>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table class="vehicle-table" id="manufacturerTable">
                    <thead>
                        <tr>
                            <th>
                                <button type="button" class="sort-button" data-column="0">
                                    <span>@Html.DisplayNameFor(m => m.Manufacturers.First().Name)</span>
                                    <span class="sort-icon">↕</span>
                                </button>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="manufacturerTableBody">
                        @foreach (var manufacturer in Model.Manufacturers)
                        {
                            <tr>
                                <td data-sort-value="@manufacturer.Name">
                                    <strong>@manufacturer.Name</strong>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@manufacturer.Id" class="action-view">View</a>
                                        <a asp-action="Edit" asp-route-id="@manufacturer.Id" class="action-edit">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@manufacturer.Id" class="action-delete">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- No Search Results -->
                <div id="noSearchResults" class="empty-state" style="display: none;">
                    <h3>No matching manufacturers</h3>
                    <p>Try changing your search text.</p>
                </div>
            </div>
        </div>
    }

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <span>
                Showing
                @((Model.CurrentPage - 1) * Model.PageSize + 1)
                -
                @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems))
                of
                @Model.TotalItems
                manufacturers
            </span>

            <div class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@Model.Search"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDirection="@Model.SortDirection">
                        Previous
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.Search"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDirection="@Model.SortDirection"
                       class="@(i == Model.CurrentPage ? "active" : "")">
                        @i
                    </a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@Model.Search"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDirection="@Model.SortDirection">
                        Next
                    </a>
                }
            </div>
        </div>
    }

</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("manufacturerSearch");
            const tableBody = document.getElementById("manufacturerTableBody");
            const noSearchResults = document.getElementById("noSearchResults");
            const searchResultCount = document.getElementById("searchResultCount");
            const sortButtons = document.querySelectorAll(".sort-button");

            // ---------- Search ----------
            if (searchInput && tableBody) {
                searchInput.addEventListener("input", function () {
                    const searchText = this.value.trim().toLowerCase();
                    const rows = Array.from(tableBody.querySelectorAll("tr"));
                    let visibleRows = 0;

                    rows.forEach(function (row) {
                        const isMatch = row.textContent.toLowerCase().includes(searchText);
                        row.style.display = isMatch ? "" : "none";
                        if (isMatch) visibleRows++;
                    });

                    searchResultCount.textContent = searchText.length > 0
                        ? `${visibleRows} matching manufacturer${visibleRows === 1 ? "" : "s"}`
                        : "";

                    noSearchResults.style.display = visibleRows === 0 ? "block" : "none";
                });
            }

            // ---------- Sorting (Name column only) ----------
            let currentSortDirection = "asc";

            sortButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    currentSortDirection = currentSortDirection === "asc" ? "desc" : "asc";

                    sortTable(currentSortDirection);
                    updateSortIcons(this, currentSortDirection);
                });
            });

            function sortTable(direction) {
                const rows = Array.from(tableBody.querySelectorAll("tr"));
                const collatorOptions = { sensitivity: "base" };

                rows.sort(function (rowA, rowB) {
                    const valueA = rowA.cells[0].dataset.sortValue ?? rowA.cells[0].textContent.trim();
                    const valueB = rowB.cells[0].dataset.sortValue ?? rowB.cells[0].textContent.trim();

                    return direction === "asc"
                        ? valueA.localeCompare(valueB, undefined, collatorOptions)
                        : valueB.localeCompare(valueA, undefined, collatorOptions);
                });

                rows.forEach(row => tableBody.appendChild(row));
            }

            function updateSortIcons(activeButton, direction) {
                sortButtons.forEach(function (button) {
                    button.querySelector(".sort-icon").textContent = "↕";
                    button.classList.remove("sort-active");
                });

                activeButton.querySelector(".sort-icon").textContent = direction === "asc" ? "↑" : "↓";
                activeButton.classList.add("sort-active");
            }
        });
    </script>
}