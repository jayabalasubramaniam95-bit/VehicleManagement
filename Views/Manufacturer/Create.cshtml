@model VehicleManagement.ViewModels.ManufacturerCreateViewModel

@{
    ViewData["Title"] = "Add Manufacturer";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>Add Manufacturer</h1>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Back to Manufacturers</a>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter manufacturer name"
                       autocomplete="off" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Manufacturer</button>
            </div>
        </form>
    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
