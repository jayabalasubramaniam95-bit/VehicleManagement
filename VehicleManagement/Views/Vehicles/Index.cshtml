@model VehicleManagement.ViewModels.VehicleListViewModel
@using VehicleManagement.ViewModels

@{
    ViewData["Title"] = "Vehicles";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>Vehicles</h1>
            <p class="page-subtitle">Manage all registered vehicles</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">+ Add Vehicle</a>
    </div>

    @foreach (var (key, css) in new[] { ("SuccessMessage", "success"), ("ErrorMessage", "danger") })
    {
        if (TempData[key] is string message)
        {
            <div class="alert alert-@css">@message</div>
        }
    }

    @* Search is a plain GET form, so it searches ALL pages on the server *@
    <form asp-action="Index" method="get" id="searchForm" class="toolbar">
        <div class="search-group">
            <label asp-for="Search"></label>
            <input asp-for="Search" class="form-control" placeholder="Search owner, manufacturer or category..." autocomplete="off" />
        </div>
        <div class="search-result-info">
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <span>@Model.TotalItems matching vehicle@(Model.TotalItems == 1 ? "" : "s")</span>
            }
        </div>
    </form>

    @if (!Model.Vehicles.Any())
    {
        <div class="empty-state">
            <h3>No vehicles found</h3>
            @if (string.IsNullOrWhiteSpace(Model.Search))
            {
                <p>There are no registered vehicles yet.</p>
                <a asp-action="Create" class="btn btn-primary">Add Vehicle</a>
            }
            else
            {
                <p>No vehicles match "<strong>@Model.Search</strong>".</p>
                <a asp-action="Index" class="btn btn-light">Clear search</a>
            }
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table id="vehicleTable" class="vehicle-table">
                    <thead>
                        <tr>
                            @* Sorted by the browser (jQuery). data-col = column index, data-type = text | number *@
                            <th>
                                <button type="button" class="sort-button sort-active" data-col="0" data-type="text">
                                    <span>@Html.DisplayNameFor(m => m.Vehicles.First().OwnerName)</span>
                                    <span class="sort-icon">↑</span>
                                </button>
                            </th>
                            <th>
                                <button type="button" class="sort-button" data-col="1" data-type="text">
                                    <span>@Html.DisplayNameFor(m => m.Vehicles.First().ManufacturerName)</span>
                                    <span class="sort-icon">↕</span>
                                </button>
                            </th>
                            <th>
                                <button type="button" class="sort-button" data-col="2" data-type="number">
                                    <span>@Html.DisplayNameFor(m => m.Vehicles.First().YearOfManufacture)</span>
                                    <span class="sort-icon">↕</span>
                                </button>
                            </th>
                            <th>
                                <button type="button" class="sort-button" data-col="3" data-type="number">
                                    <span>@Html.DisplayNameFor(m => m.Vehicles.First().Weight)</span>
                                    <span class="sort-icon">↕</span>
                                </button>
                            </th>
                            <th>
                                <button type="button" class="sort-button" data-col="4" data-type="text">
                                    <span>@Html.DisplayNameFor(m => m.Vehicles.First().CategoryName)</span>
                                    <span class="sort-icon">↕</span>
                                </button>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="vehicleTableBody">
                        @foreach (var vehicle in Model.Vehicles)
                        {
                            <tr>
                                <td data-sort-value="@vehicle.OwnerName">@vehicle.OwnerName</td>
                                <td data-sort-value="@vehicle.ManufacturerName">@vehicle.ManufacturerName</td>
                                <td data-sort-value="@vehicle.YearOfManufacture">@vehicle.YearOfManufacture</td>
                                <td data-sort-value="@vehicle.WeightSortKey">@vehicle.Weight.ToString("0.00")</td>
                                <td data-sort-value="@vehicle.CategoryName">
                                    <div class="vehicle-category">
                                        <i class="bi @VehicleCategoryIcons.GetCssClass(vehicle.CategoryIcon) me-2" aria-hidden="true"></i>
                                        <span class="category-name">@vehicle.CategoryName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@vehicle.Id" class="action-view">View</a>
                                        <a asp-action="Edit" asp-route-id="@vehicle.Id" class="action-edit">Edit</a>
                                        <a href="#" role="button" class="action-delete"
                                           data-delete-id="@vehicle.Id"
                                           data-delete-name="@vehicle.OwnerName">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div class="pagination-container">
            <div class="pagination-summary">
                Showing <strong>@Model.FirstItem</strong> - <strong>@Model.LastItem</strong>
                of <strong>@Model.TotalItems</strong> vehicles
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination" aria-label="Vehicle pagination">

                    @if (Model.HasPrevious)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-search="@Model.Search" class="pagination-link">&laquo; Previous</a>
                    }
                    else
                    {
                        <span class="pagination-link disabled">&laquo; Previous</span>
                    }

                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="pagination-link active" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@pageNumber"
                               asp-route-search="@Model.Search" class="pagination-link">@pageNumber</a>
                        }
                    }

                    @if (Model.HasNext)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-search="@Model.Search" class="pagination-link">Next &raquo;</a>
                    }
                    else
                    {
                        <span class="pagination-link disabled">Next &raquo;</span>
                    }

                </nav>
            }
        </div>
    }

</div>

@* Delete confirmation popup: one shared dialog, filled in when a Delete button is clicked *@
<dialog id="deleteDialog" class="delete-dialog" aria-labelledby="deleteTitle">
    <form id="deleteForm" asp-action="Delete" method="post">
        <input type="hidden" name="id" id="deleteId" />

        <div class="delete-dialog-body">
            <div class="delete-dialog-icon" aria-hidden="true">
                <i class="bi bi-trash3"></i>
            </div>
            <div>
                <h3 id="deleteTitle" class="delete-dialog-title">Delete vehicle?</h3>
                <p class="delete-dialog-text">Are you sure to delete the vehicle owned by <strong id="deleteName"></strong>?</p>
            </div>
        </div>

        <div class="delete-dialog-footer">
            <button type="button" class="btn btn-light" data-close-dialog>Cancel</button>
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Delete
            </button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script>
        $(function () {
            // ----- Search: submit the GET form shortly after the user stops typing -----
            const $search = $('#Search');
            let timer;

            $search.on('input', function () {
                clearTimeout(timer);
                timer = setTimeout(() => $('#searchForm').get(0).submit(), 400);
            });

            // Page reloads after searching, so put the caret back at the end of the text
            if ($search.val()) {
                const el = $search.get(0);
                el.focus();
                el.setSelectionRange(el.value.length, el.value.length);
            }

            // ----- Sort: pure jQuery, toggles asc/desc on the rows already in the table (no server call) -----
            const $body = $('#vehicleTableBody');
            const $buttons = $('.sort-button');
            let sortCol = 0, sortDir = 'asc';   // matches the server's default order (owner ascending)

            const cellValue = (row, col) => $(row).children('td').eq(col).attr('data-sort-value') || '';

            const comparers = {
                text:   (a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }),
                number: (a, b) => Number(a) - Number(b)
            };

            $buttons.on('click', function () {
                const col = $(this).data('col');
                const compare = comparers[$(this).data('type')];

                // Same column: flip direction. New column: start ascending.
                sortDir = (col === sortCol && sortDir === 'asc') ? 'desc' : 'asc';
                sortCol = col;
                const sign = sortDir === 'asc' ? 1 : -1;

                // Re-appending the existing <tr> elements moves them; nothing is re-rendered or re-fetched
                $body.append($body.children('tr').get().sort((a, b) =>
                    sign * compare(cellValue(a, col), cellValue(b, col))));

                $buttons.removeClass('sort-active').find('.sort-icon').text('↕');
                $(this).addClass('sort-active').find('.sort-icon').text(sortDir === 'asc' ? '↑' : '↓');
            });

            // ----- Delete popup -----
            const dialog = document.getElementById('deleteDialog');

            $('[data-delete-id]').on('click', function (e) {
                e.preventDefault();  
                $('#deleteId').val($(this).data('delete-id'));
                $('#deleteName').text($(this).data('delete-name'));
                dialog.showModal();
            });

            $('[data-close-dialog]').on('click', () => dialog.close());

            // Clicking the dark backdrop closes the popup
            $(dialog).on('click', e => { if (e.target === dialog) dialog.close(); });

            // Prevent double submit
            $('#deleteForm').on('submit', function () {
                $(this).find(':submit').prop('disabled', true);
            });
        });
    </script>
}
